#pragma once
#include <metal_stdlib>
using namespace metal;

// Buffer layouts shared with the host: MetalShaderTypes.h for Camera and Projected,
// splatkit/rendering/GpuLayout.h for Splat.
struct Camera {
  float4x4 view;
  float4x4 proj;
  float2 focal;         // pixels: screenSize * proj[0][0] / 2, screenSize * proj[1][1] / 2
  float2 tanHalfFov;   // 1 / proj[0][0], 1 / proj[1][1]
  float2 screenSize;   // pixels
  uint outputLinear;   // 1 when the target is sRGB and expects linear values
  uint pad;
  float4 cameraPosition;  // world space
};

// Spherical harmonics: degree by function constant, so degree 0 pays nothing.
constant uint SH_DEGREE [[function_constant(0)]];
constant uint SH_COEFFICIENTS = (SH_DEGREE + 1) * (SH_DEGREE + 1) - 1;
constant uint SH_STRIDE = (SH_COEFFICIENTS * 3 + 1) / 2;

struct Splat {
  float px, py, pz;  // world position
  uint rgba8;        // colour and alpha, 8 bits each
  uint cov0;         // halves: xx, xy
  uint cov1;         // halves: xz, yy
  uint cov2;         // halves: yz, zz
  uint lodAlpha;     // float bits of an opacity above 1, else 0
};

// A splat after projection: the quad the raster stage expands (32 bytes).
struct Projected {
  float2 center;
  uint axis1;
  uint axis2;
  uint color0;
  uint color1;
  float radius;
  uint index;
};

struct SplatVertex {
  float4 position [[position]];
  float2 relativePosition;
  float4 color;
};

struct BlitVertex {
  float4 position [[position]];
  float2 uv;
};

struct MaskOut {
  float depth [[depth(any)]];
};

struct Range {
  uint offset;
  uint count;
};

struct SortDispatch {
  uint threadgroupsX, threadgroupsY, threadgroupsZ;
  uint blocks;
};

struct DrawArguments {
  uint vertexCount, instanceCount, vertexStart, baseInstance;
};

// Splats draw at kSplatDepth under a LessEqual test; the saturation mask writes the nearer
// kMaskDepth, so a pixel that is already opaque rejects every later splat.
constant float kSplatDepth = 0.5;
constant float kMaskDepth = 0.25;
constant float kSaturated = 254.0 / 255.0;  // coverage at which a pixel counts as opaque
constant float3 kBackground = float3(0.05, 0.05, 0.08);  // kBackground in MetalSplatRenderer.mm

constant float kBoundsRadius = 3.0;     // draw out to 3 sigma; beyond that nothing is visible
constant float kLodBoundsRadius = 5.0;  // an opacity of 1000 stays solid out past 3 sigma
constant float kMinPixelRadius = 1.0;
// Variance, in squared pixels, added to every projected covariance: the low-pass filter of
// the reference 3DGS rasterizer, which stops a splat shrinking below about a pixel.
constant float kLowPassVariance = 0.3;
// A splat's view-space x/y is clamped to this multiple of the half field of view before the
// projection is linearised, which bounds the error of the linearisation near the edges.
constant float kProjectionFovClamp = 1.3;
// Loose culling keeps a splat whose centre is within this multiple of the clip extent.
constant float kLooseCullExtent = 1.2;
constant float kDisplayGamma = 2.2;  // for a linear-blended output
constant float2 kCorners[4] = {float2(-1, -1), float2(-1, 1), float2(1, -1), float2(1, 1)};

inline float2 unpackHalf2(uint packed) {
  return float2(as_type<half2>(packed));
}

inline float4 unpackUnorm4x8(uint packed) {
  return float4(packed & 0xffu, (packed >> 8) & 0xffu, (packed >> 16) & 0xffu, packed >> 24) / 255.0;
}
