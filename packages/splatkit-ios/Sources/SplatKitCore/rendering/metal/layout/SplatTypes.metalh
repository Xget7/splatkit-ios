#pragma once
#include <metal_stdlib>
using namespace metal;

// Buffer layouts shared with the host: MetalShaderTypes.h for Camera,
// splatkit/rendering/GpuLayout.h for Splat and Projected.
struct Camera {
  float4x4 view;
  float4x4 proj;
  float2 focal;         // pixels: screenSize * proj[0][0] / 2, screenSize * proj[1][1] / 2
  float2 tanHalfFov;   // 1 / proj[0][0], 1 / proj[1][1]
  float2 screenSize;   // pixels
  uint outputLinear;   // 1 when the target is sRGB and expects linear values
  float minPixelRadius;  // pixels: smallest source sigma times quad radius that is drawn
  float4 cameraPosition;  // world space
};

// Spherical harmonics: degree by function constant, so degree 0 pays nothing.
constant uint SH_DEGREE [[function_constant(0)]];
constant uint SH_COEFFICIENTS = (SH_DEGREE + 1) * (SH_DEGREE + 1) - 1;
constant uint SH_STRIDE = (SH_COEFFICIENTS * 3 + 1) / 2;

struct Splat {
  float px, py, pz;  // world position
  uint rgba8;        // colour and alpha, 8 bits each
  uint cov0;         // halves: xx, xy
  uint cov1;         // halves: xz, yy
  uint cov2;         // halves: yz, zz
  uint lodAlpha;     // float bits of an opacity above 1, else 0
};

// A splat after projection: the quad the raster stage expands (32 bytes).
struct Projected {
  float2 center;
  uint axis1;
  uint axis2;
  uint color0;
  uint color1;
  float radius;
  uint index;
};

// Every vertex output crosses the tiler's parameter buffer, four per splat, so the record is
// kept to 24 bytes: depth carries log2 of the peak opacity (splatDepth) at full float precision,
// since a quad's depth is constant and only has to stay between the mask and the clear.
struct SplatVertex {
  float4 position [[position]];
  half2 gaussian;       // corner * radius * kGaussianScale; its squared length is the exp2 exponent
  uint color [[flat]];  // packColor: rgb as unorm 10:10:10 and a 2-bit scale
};

struct BlitVertex {
  float4 position [[position]];
  float2 uv;
};

struct MaskOut {
  float depth [[depth(any)]];
};

struct Range {
  uint offset;
  uint count;
};

struct SortDispatch {
  uint threadgroupsX, threadgroupsY, threadgroupsZ;
  uint blocks;
};

struct DrawArguments {
  uint vertexCount, instanceCount, vertexStart, baseInstance;
};

// Splats draw around kSplatDepth under a LessEqual test; the saturation mask writes the nearer
// kMaskDepth, so a pixel that is already opaque rejects every later splat.
constant float kSplatDepth = 0.5;
constant float kMaskDepth = 0.25;
constant float kSaturated = 254.0 / 255.0;  // coverage at which a pixel counts as opaque
// A splat's depth is kSplatDepth plus its log2 opacity times this scale. Clamped to
// kMaxLog2Alpha, depths stay within [0.375, 0.625]: behind the mask and in front of the clear.
constant float kAlphaDepthScale = 1.0 / 128.0;
constant float kMaxLog2Alpha = 16.0;
constant half kMaxColorScale = 4.0h;  // the brightest colour channel a splat vertex carries

// A quad stops where the Gaussian falls to kQuadMinAlpha, and never past these radii: a blob at
// 2.5 sigma keeps 4 % of its peak, and an LOD opacity of 1000 stays visible out to 4.9 sigma.
constant float kBoundsRadius = 2.5;
constant float kLodBoundsRadius = 5.0;
// The host defines this cutoff (MetalShaderTypes.h) so the reported policy fallback cannot drift
// from the shader.
constant float kQuadMinAlpha = SPLAT_QUAD_MIN_ALPHA;
// A splat near the camera can project to thousands of pixels; its quad is cut here instead.
constant float kMaxPixelRadius = 512.0;
// Variance, in squared pixels, added to every projected covariance: the low-pass filter of
// the reference 3DGS rasterizer, which stops a splat shrinking below about a pixel.
constant float kLowPassVariance = 0.3;
// A splat's view-space x/y is clamped to this multiple of the half field of view before the
// projection is linearised, which bounds the error of the linearisation near the edges.
constant float kProjectionFovClamp = 1.3;
constant float kDisplayGamma = 2.2;  // for a linear-blended output
constant float2 kCorners[4] = {float2(-1, -1), float2(-1, 1), float2(1, -1), float2(1, 1)};
constant float kGaussianScale = 0.8493218;  // sqrt(0.5 * log2(e)): exp(-0.5 r^2) = exp2(-(kGaussianScale r)^2)
constant half kLog2MinAlpha = -7.994353h;   // log2(1/255)

inline float2 unpackHalf2(uint packed) {
  return float2(as_type<half2>(packed));
}

inline float4 unpackUnorm4x8(uint packed) {
  return float4(packed & 0xffu, (packed >> 8) & 0xffu, (packed >> 16) & 0xffu, packed >> 24) / 255.0;
}
